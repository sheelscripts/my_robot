<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="warehouse">
    
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (Concrete Warehouse Floor) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== PERIMETER WALLS (20m x 20m) ==================== -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.4 0.4 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20.4 0.4 3.0</size></box></geometry><material><ambient>0.8 0.8 0.85 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.4 0.4 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20.4 0.4 3.0</size></box></geometry><material><ambient>0.8 0.8 0.85 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 20.4 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 20.4 3.0</size></box></geometry><material><ambient>0.8 0.8 0.85 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 20.4 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 20.4 3.0</size></box></geometry><material><ambient>0.8 0.8 0.85 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ==================== STORAGE RACK AISLES ==================== -->
    <!-- Rack Row A (Left Aisle) -->
    <model name="rack_a1">
      <static>true</static>
      <pose>-5 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 5.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 5.0 2.5</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.2 0.4 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rack_a2">
      <static>true</static>
      <pose>-5 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 5.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 5.0 2.5</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.2 0.4 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Rack Row B (Center Aisle) -->
    <model name="rack_b1">
      <static>true</static>
      <pose>0 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 5.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 5.0 2.5</size></box></geometry><material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rack_b2">
      <static>true</static>
      <pose>0 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 5.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 5.0 2.5</size></box></geometry><material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Rack Row C (Right Aisle) -->
    <model name="rack_c1">
      <static>true</static>
      <pose>5 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 5.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 5.0 2.5</size></box></geometry><material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rack_c2">
      <static>true</static>
      <pose>5 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 5.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 5.0 2.5</size></box></geometry><material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ==================== PALLET STACKS & BOXES ==================== -->
    <model name="pallet_stack_1">
      <static>true</static>
      <pose>-8 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 1.2 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 1.2</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="pallet_stack_2">
      <static>true</static>
      <pose>8 2 0.6 0 0 0.5</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 1.2 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 1.2</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="barrel_obstacle_1">
      <static>true</static>
      <pose>-2.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="barrel_obstacle_2">
      <static>true</static>
      <pose>2.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
