<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
           schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>agv_robot</name>
  <version>0.1.0</version>

  <description>
    AGV robot simulation, SLAM mapping, and Nav2 autonomous navigation
  </description>

  <maintainer email="user@robot.local">rosuser</maintainer>
  <license>Apache-2.0</license>

  <!-- Python nodes -->
  <depend>rclpy</depend>

  <!-- Robot description / TF -->
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>

  <!-- Gazebo Harmonic integration -->
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <!-- Mapping -->
  <depend>slam_toolbox</depend>

  <!-- Navigation -->
  <depend>nav2_bringup</depend>
  <depend>nav2_map_server</depend>

  <!-- Visualization -->
  <depend>rviz2</depend>

  <!-- Manual control -->
  <depend>teleop_twist_keyboard</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>