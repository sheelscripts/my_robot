<?xml version="1.0" ?>
<robot name="agv" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Chassis Physical Dimensions & Mass -->
  <xacro:property name="chassis_length" value="1.558"/>
  <xacro:property name="chassis_width" value="0.965"/>
  <xacro:property name="chassis_height" value="0.280"/>
  <xacro:property name="chassis_mass" value="300"/>
  
  <!-- Caster Wheel Dimensions -->
  <xacro:property name="caster_radius" value="0.062"/>

  <!-- Drive Wheel Dimensions -->
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_mass" value="2"/>

  <!-- Included Configurations & Modules -->
  <xacro:include filename="config/common_properties.xacro"/>
  <xacro:include filename="config/laser_correction.xacro"/>
  <xacro:include filename="config/camera_correction.xacro"/>
  <xacro:include filename="config/imu_joint.xacro"/>
  <xacro:include filename="agv.gazebo.xacro"/>
  <xacro:include filename="agv.macros.xacro"/>
  
  <!-- Base Footprint & Link -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <collision><geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry></collision>
    <visual><geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry><material name="grey"/></visual>
    <inertial>
      <mass value="${chassis_mass}" />
      <inertia ixx="3.9687" ixy="0.28534" ixz="0.11898" iyy="11.378" iyz="0.00735" izz="8.1939" />
    </inertial>  
  </link>

  <!-- Drive Wheels -->
  <wheel wheel_side="left" offset_y="0.40649"/>
  <wheel wheel_side="right" offset_y="-0.40649"/>

  <!-- Caster Wheels -->
  <caster prefix="left_front" offset_x="0.650" offset_y="0.400" mass="5.2"/>
  <caster prefix="right_front" offset_x="0.650" offset_y="-0.400" mass="5.2"/>
  <caster prefix="left_back" offset_x="-0.650" offset_y="0.400" mass="0.01"/>
  <caster prefix="right_back" offset_x="-0.650" offset_y="-0.400" mass="0.01"/>

  <!-- Lasers -->
  <laser_sensor name="laser_front" x="${laser_front_x}" y="${laser_front_y}" z="${laser_front_z}" roll="${laser_front_roll}" pitch="${laser_front_pitch}" yaw="${laser_front_yaw}"/>
  <laser_sensor name="laser_back" x="${laser_back_x}" y="${laser_back_y}" z="${laser_back_z}" roll="${laser_back_roll}" pitch="${laser_back_pitch}" yaw="${laser_back_yaw}"/>
  <laser_sensor name="laser_3d" x="${laser_3d_x}" y="${laser_3d_y}" z="${laser_3d_z}" roll="${laser_3d_roll}" pitch="${laser_3d_pitch}" yaw="${laser_3d_yaw}" mass="1.5"/>

  <!-- IMU Sensor -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

  <!-- Cameras (Mounts + Optical Frames) -->
  <camera_mount num="1" x="${camera_1_x}" y="${camera_1_y}" z="${camera_1_z}" roll="${camera_1_roll}" pitch="${camera_1_pitch}" yaw="${camera_1_yaw}"/>
  <camera_mount num="2" x="${camera_2_x}" y="${camera_2_y}" z="${camera_2_z}" roll="${camera_2_roll}" pitch="${camera_2_pitch}" yaw="${camera_2_yaw}"/>
  <camera_mount num="3" x="${camera_3_x}" y="${camera_3_y}" z="${camera_3_z}" roll="${camera_3_roll}" pitch="${camera_3_pitch}" yaw="${camera_3_yaw}"/>
  <camera_mount num="4" x="${camera_4_x}" y="${camera_4_y}" z="${camera_4_z}" roll="${camera_4_roll}" pitch="${camera_4_pitch}" yaw="${camera_4_yaw}"/>

</robot>
