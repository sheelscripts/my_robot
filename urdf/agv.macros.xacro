<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Inertia Calculation Helpers -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertia  ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
              iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0"
              izz="${mass*radius*radius/2}" /> 
  </xacro:macro>

  <xacro:macro name="box_inertia" params="mass size_x size_y size_z">
    <inertia  ixx="${mass*(size_y*size_y + size_z*size_z)/12}" ixy="0" ixz="0"
              iyy="${mass*(size_x*size_x + size_z*size_z)/12}" iyz="0"
              izz="${mass*(size_x*size_x + size_y*size_y)/12}" /> 
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertia ixx="${2*mass*radius*radius/5}" ixy="0" ixz="0"
             iyy="${2*mass*radius*radius/5}" iyz="0"
             izz="${2*mass*radius*radius/5}" /> 
  </xacro:macro>

  <!-- Drive Wheel Macro -->
  <xacro:macro name="wheel" params="wheel_side offset_y">
    <joint name="${wheel_side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${wheel_side}_wheel"/>
      <origin xyz="0.0 ${offset_y} ${wheel_offset_z}" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${wheel_side}_wheel">
      <visual>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}" />
        <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
      </inertial>
    </link>
    <gazebo reference="${wheel_side}_wheel">
      <mu1>10.0</mu1>
      <mu2>10.0</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <maxVel>1.1</maxVel>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- Single Passive Caster Macro -->
  <xacro:macro name="caster" params="prefix offset_x offset_y mass:=${caster_mass} mu1:=0.0 mu2:=0.0">
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster"/>
      <origin xyz="${offset_x} ${offset_y} ${caster_offset_z}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}" /></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <xacro:sphere_inertia mass="${mass}" radius="${caster_radius}"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}_caster">
      <mu1>${mu1}</mu1>
      <mu2>${mu2}</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <maxVel>1.0</maxVel>
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:macro>

  <!-- Symmetric Caster Pair Macro (Left & Right) -->
  <xacro:macro name="caster_pair" params="location offset_x offset_y mass:=${caster_mass}">
    <xacro:caster prefix="left_${location}"  offset_x="${offset_x}" offset_y="${offset_y}"  mass="${mass}"/>
    <xacro:caster prefix="right_${location}" offset_x="${offset_x}" offset_y="${-offset_y}" mass="${mass}"/>
  </xacro:macro>

  <!-- Self-Contained Cylindrical LiDAR Macro (Kinematics + Gz Sim Sensor Stream) -->
  <xacro:macro name="lidar_sensor" params="name x y z roll pitch yaw topic_name mass:=0.5925 length:=0.151 radius:=0.05 samples:=360 v_samples:=1 h_resolution:=1 v_resolution:=1 min_angle:=-3.14159 max_angle:=3.14159 v_min_angle:=-0.261799 v_max_angle:=0.261799 min_range:=0.120 max_range:=15.0 range_resolution:=0.01 update_rate:=20.0 noise_stddev:=0.01">
    <link name="${name}_link">
      <visual>
        <geometry><cylinder length="${length}" radius="${radius}"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><cylinder length="${length}" radius="${radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass}" />
        <origin xyz="-7.88E-05 4.35E-05 -0.01694" rpy="0 0 0" />
        <xacro:cylinder_inertia mass="${mass}" radius="${radius}" length="${length}"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>

    <!-- Encapsulated Gz Sim LiDAR Sensor -->
    <gazebo reference="${name}_link">
      <material>Gazebo/Blue</material>
      <sensor name="${name}_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>false</visualize>
        <topic>${topic_name}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>${h_resolution}</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
            <xacro:if value="${v_samples > 1}">
              <vertical>
                <samples>${v_samples}</samples>
                <resolution>${v_resolution}</resolution>
                <min_angle>${v_min_angle}</min_angle>
                <max_angle>${v_max_angle}</max_angle>
              </vertical>
            </xacro:if>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>${range_resolution}</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${noise_stddev}</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Self-Contained Camera Macro (Kinematics + Optical Frame + Gz Sim Stream) -->
  <xacro:macro name="camera_mount" params="name x y z roll pitch yaw width:=640 height:=480 hfov:=1.5184 update_rate:=30.0">
    <link name="${name}_link">
      <visual>
        <geometry><box size="0.025 0.090 0.025"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><box size="0.025 0.090 0.025"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia mass="0.1" size_x="0.025" size_y="0.090" size_z="0.025"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>

    <link name="${name}_color_optical_frame"/>
    <joint name="${name}_color_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    </joint>

    <!-- Encapsulated Gz Sim Camera Sensor -->
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="camera">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>false</visualize>
        <topic>/${name}/image_raw</topic>
        <gz_frame_id>${name}_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
