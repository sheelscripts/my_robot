<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Inertia Calculation Macros -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertia  ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
              iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0"
              izz="${mass*radius*radius/2}" /> 
  </xacro:macro>

  <xacro:macro name="box_inertia" params="mass size_x size_y size_z">
    <inertia  ixx="${mass*(size_y*size_y + size_z*size_z)/12}" ixy="0" ixz="0"
              iyy="${mass*(size_x*size_x + size_z*size_z)/12}" iyz="0"
              izz="${mass*(size_x*size_x + size_z*size_z)/12}" /> 
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertia  ixx="${2*mass*radius*radius/5}" ixy="0" ixz="0"
              iyy="${2*mass*radius*radius/5}" iyz="0"
              izz="${2*mass*radius*radius/5}" /> 
  </xacro:macro>

  <!-- Drive Wheel Macro -->
  <xacro:macro name="wheel" params="wheel_side offset_y">
    <joint name="${wheel_side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${wheel_side}_wheel"/>
      <origin xyz="0.0 ${offset_y} -0.04625" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${wheel_side}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.01300" ixy="0.0" ixz="0.0"
                 iyy="0.007042" iyz="0.0"
                 izz="0.007042" />
      </inertial>
      <gazebo reference="${wheel_side}_wheel">
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <kp>500000.0</kp>
        <kd>10.0</kd>
        <maxVel>1.1</maxVel>
        <material>Gazebo/Black</material>
      </gazebo>
    </link>
  </xacro:macro>

  <!-- Front Caster Wheel Macro -->
  <xacro:macro name="caster_front" params="caster_side offset_y">
    <joint name="${caster_side}_caster_front_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${caster_side}_caster_front"/>
      <origin xyz="0.650 ${offset_y} -0.109" rpy="0 0 0"/>
    </joint>

    <link name="${caster_side}_caster_front">
      <visual>
        <origin xyz="0 0 0" rpy="0 ${M_PI/2} 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 ${M_PI/2} 0" />
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 ${M_PI/2} 0" />
        <mass value="${caster_mass}"/>
        <sphere_inertia mass="${caster_mass}" radius="${caster_radius}"/>
      </inertial>
    </link>

    <gazebo reference="${caster_side}_caster_front">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <maxVel>1.0</maxVel>
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:macro>

  <!-- Back Caster Wheel Macro -->
  <xacro:macro name="caster_back" params="caster_side offset_y">
    <joint name="${caster_side}_caster_back_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${caster_side}_caster_back"/>
      <origin xyz="-0.650 ${offset_y} -0.109" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${caster_side}_caster_back">
      <visual>
        <origin xyz="0 0 0" rpy="0 ${M_PI/2} 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 ${M_PI/2} 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.0" />
        <mass value="0.01" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                 iyy="0.001" iyz="0.0"
                 izz="0.0001" />
      </inertial>
    </link>

    <gazebo reference="${caster_side}_caster_back">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <maxVel>3.0</maxVel>
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:macro>

</robot>
